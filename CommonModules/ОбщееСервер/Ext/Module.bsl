  
Функция ОпределитьКоличествоПравельныхВопросов()     Экспорт
	 		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ПравельныеОтветы.Вопросы) КАК Кол
		|ИЗ
		|	РегистрСведений.ПравельныеОтветы КАК ПравельныеОтветы";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат  Выборка.Кол;
	КонецЕсли;
	Возврат 0;
	

КонецФункции  


