#Область ЗагрузкаНаФормуВопросов 

&НаКлиенте
Процедура ЗагрузитьВопросы(Команда) 
	СообщениеОКоличествеВопросов = "";
	Элементы.СообщениеОКоличествеВопросов.Видимость=Ложь;   
	Элементы.КоличествоОтветовПравельно.Видимость=Ложь;
	Элементы.КоличествоОтветовНеправельно.Видимость = Ложь;
	ЭтаФорма.КоличествоОтветовПравельно = 0;
	ЭтаФорма.КоличествоОтветовНеправельно = 0; 
	ЭтаФорма.КоличествоВопросовВсего = 0;
	ЭтаФорма.ОсталосьОтветитьНаВопросы = 0;
	//Очистка формы
	ЭтаФорма.ВариантыОтветов.Очистить();
	
	ВопросыДляЗагрузки = ВыборкаВопросовДляТестирования();
	Если ПоказатьОтвет = Ложь Тогда
		ЗапускТаймераОбщее(); 
	КонецЕсли;
	ЭтаФорма.КоличествоВопросовВсего = ВопросыДляЗагрузки.Количество();
	
	Для Каждого Строка из ВопросыДляЗагрузки Цикл
		НоваяСтрока = ЭтаФорма.Вопросы.Добавить();
		ДанныеДляТЗ = ЗагрузитьВопросыНаСервере(Строка);
		НоваяСтрока["Вопрос"] = ДанныеДляТЗ.Вопрос;
		НоваяСтрока["Ссылка"] = ДанныеДляТЗ.Ссылка;   
	КонецЦикла;	
	ДвигатьсяВперед(Истина);
	ПоказатьОтвет();
КонецПроцедуры
&НаСервере
Функция ЗагрузитьВопросыНаСервере(Строка)
	 ЭлементВопрос = Строка.ПолучитьОбъект(); 
	 Результат = Новый Структура;
	 Для Каждого СтрокиОтветов из ЭлементВопрос.ВариантыОтветов Цикл
		ЕщеСтрока = ЭтаФорма.ВариантыОтветов.Добавить();
		ЕщеСтрока["Вопрос"] = ЭлементВопрос.Вопрос;
		ЕщеСтрока["Ответ"] = СтрокиОтветов.Ответ;
		ЕщеСтрока["ПравельныйОтвет"] = СтрокиОтветов.ПравельныйОтвет;
		ЕщеСтрока["ДополнительныеОтметки"] = СтрокиОтветов.ДополнительныеОтметки;	
	 КонецЦикла;
	 Результат.Вставить("Вопрос",ЭлементВопрос.Вопрос);
	 Результат.Вставить("Ссылка",ЭлементВопрос.Ссылка);
	 
	 Возврат  Результат;
КонецФункции	
&НаСервере
Процедура ПодготовитьВопросКОтображению()
	КоличествоВопросов = ЭтаФорма.Вопросы.Количество();  
	Если КоличествоВопросов = 0 Тогда
		Возврат;
	КонецЕсли;	
	
		ЭтаФорма.ОсталосьОтветитьНаВопросы  =  КоличествоВопросов;
		ГСЧ = Новый ГенераторСлучайныхЧисел;

		СлучайноеЧисло = ГСЧ.СлучайноеЧисло(0, КоличествоВопросов-1);		
		Объект.Вопрос = ЭтаФорма.Вопросы[СлучайноеЧисло].Вопрос;
		Объект.Ссылка = ЭтаФорма.Вопросы[СлучайноеЧисло].Ссылка;		
		КартинкаВопроса = ПолучитьНавигационнуюСсылку(Объект.Ссылка,"ДанныеКартинки");
		Элементы.КартинкаВопроса.РазмерКартинки = РазмерКартинки.Пропорционально;
		Объект.ВариантыОтветов.Очистить();
			Для Каждого Строка из ЭтаФорма.ВариантыОтветов Цикл  
				Если Строка(Объект.Вопрос) = Строка(Строка.Вопрос) Тогда
					НоваяСтрока = Объект.ВариантыОтветов.Добавить();
					НоваяСтрока.Вариант = Строка.Ответ;
					НоваяСтрока.ПравельныйОтвет = Строка.ПравельныйОтвет;
					НоваяСтрока.ДополнительныеОтметки = Строка.ДополнительныеОтметки;
				КонецЕсли;
			КонецЦикла;	
		// Перед удалением считываем данные с строки	
		ЭтаФорма.Вопросы.Удалить(СлучайноеЧисло);

КонецПроцедуры	
&НаКлиенте
Процедура ЗадатьВопрос()
	ПоказатьВопрос(Новый ОписаниеОповещения("ВопросЗаписьВРегистрСведений",ЭтотОбъект),"Записать результат тестирования?",РежимДиалогаВопрос.ДаНет);	
КонецПроцедуры	

&НаСервере
Процедура ДвигатьсяВперед(ЗагрузкаВопросов)  
	Если ЭтаФорма.ОсталосьОтветитьНаВопросы = 1 и ЭтаФорма.Вопросы.Количество()=0 Тогда
		ЭтаФорма.ОсталосьОтветитьНаВопросы = ЭтаФорма.ОсталосьОтветитьНаВопросы -1;		
	КонецЕсли;
	Если ЗагрузкаВопросов Тогда
		ПодготовитьВопросКОтображению();
	Иначе	
		Если ЭтаФорма.ОсталосьОтветитьНаВопросы = 0  Тогда
			ЗаписатьРезультатПослеТеста();
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Вопросов нет";
			Сообщение.Сообщить();	
			ЭтаФорма.ВариантыОтветов.Очистить(); 
			РезультатТестирования();
		Иначе 
			ПодготовитьВопросКОтображению();		
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	
