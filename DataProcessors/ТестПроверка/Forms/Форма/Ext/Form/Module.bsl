	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыбранныеВопросы.Вопросы КАК Вопросы,
		|	ВыбранныеВопросы.Глава КАК Глава,
		|	ВЫБОР
		|		КОГДА ВыбранныеВопросы.Глава = ЗНАЧЕНИЕ(Перечисление.Главы.Глава1)
		|			ТОГДА 1
		|		КОГДА ВыбранныеВопросы.Глава = ЗНАЧЕНИЕ(Перечисление.Главы.Глава2)
		|			ТОГДА 2
		|		КОГДА ВыбранныеВопросы.Глава = ЗНАЧЕНИЕ(Перечисление.Главы.Глава3)
		|			ТОГДА 3
		|		КОГДА ВыбранныеВопросы.Глава = ЗНАЧЕНИЕ(Перечисление.Главы.Глава4)
		|			ТОГДА 4
		|		КОГДА ВыбранныеВопросы.Глава = ЗНАЧЕНИЕ(Перечисление.Главы.Глава5)
		|			ТОГДА 5
		|		КОГДА ВыбранныеВопросы.Глава = ЗНАЧЕНИЕ(Перечисление.Главы.Глава6)
