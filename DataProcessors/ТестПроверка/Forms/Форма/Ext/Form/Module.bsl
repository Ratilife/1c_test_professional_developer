&НаСервере
Процедура ЗаписатьРезультатПослеТеста()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравельныеОтветы.Вопросы КАК Вопрос
		|ИЗ
		|	РегистрСведений.ПравельныеОтветы КАК ПравельныеОтветы";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
    МЗПравельно = РегистрыСведений.ПравельныеОтветы.СоздатьМенеджерЗаписи();

	Для Каждого Строка из ЗаписьПослеТеста Цикл  
		Если Строка.Результат Тогда
			Пока Выборка.Следующий() Цикл
				Если Выборка.Вопрос = Строка.Вопрос Тогда
				 	Продолжить;
			 	Иначе    
				 
					МЗПравельно.Период = ТекущаяДата();
					МЗПравельно.Глава = Объект.Ссылка.Глава; 
					МЗПравельно.Вопросы = Объект.Ссылка;
					МЗПравельно.Записать(Ложь);
 
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
	
	//Запись неправельных ответов    
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НеПравельныеОтветыУчитьЗаново.Вопросы КАК Вопросы
		|ИЗ
		|	РегистрСведений.НеПравельныеОтветыУчитьЗаново КАК НеПравельныеОтветыУчитьЗаново";
	
	РезультатЗапроса = Запрос.Выполнить();
	МЗНеправельно = РегистрыСведений.НеПравельныеОтветыУчитьЗаново.СоздатьМенеджерЗаписи();
	Выборка = РезультатЗапроса.Выбрать();
	
	Для Каждого Строка из ЗаписьПослеТеста Цикл  
		Если Строка.Результат = Ложь Тогда
			Пока Выборка.Следующий() Цикл
				Если Выборка.Вопрос = Строка.Вопрос Тогда
				 	Продолжить;
			 	Иначе    		 
					МЗПравельно.Период = ТекущаяДата();
					МЗПравельно.Глава = Объект.Ссылка.Глава; 
					МЗПравельно.Вопросы = Объект.Ссылка;
					МЗПравельно.Записать(Ложь);
				КонецЕсли; 
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;		
КонецПроцедуры
